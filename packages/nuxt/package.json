  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.0.0",
    "nuxt": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}