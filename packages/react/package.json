{
  "name": "@codeplayer71/audio-recorder-react",
  "version": "0.0.0",
  "description": "Fully typed React audio recorder hook and ready-to-use recorder component based on the MediaRecorder API.",
  "keywords": [
    "audio",
    "audio-recorder",
    "hook",
    "media-recorder",
    "mediarecorder",
    "microphone",
    "react",
    "react-hook",
    "recording",
    "typescript",
    "voice-recorder"
  ],
  "author": {
    "name": "Jasminko Milicevic",
    "url": "https://jamit.one"
  },
  "license": "MIT",
  "homepage": "https://github.com/codeplayer71/jamit-audio-recorder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeplayer71/jamit-audio-recorder.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/codeplayer71/jamit-audio-recorder/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
